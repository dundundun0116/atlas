{
  "openapi": "3.1.0",
  "info": {
    "title": "CompassRAG ResearchTool",
    "summary": "检索决策 Agent 对外接口：answer + evidence + confidence + stop_reason",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/research/async": {
      "post": {
        "summary": "Research Async Endpoint",
        "description": "规范化异步入口：返回 202 + RunSummary(queued)，用 SSE 订阅进度。",
        "operationId": "research_async_endpoint_research_async_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/research/sync": {
      "post": {
        "summary": "Research Sync Endpoint",
        "description": "规范化同步入口：等答案返回 `ResearchResult`。",
        "operationId": "research_sync_endpoint_research_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/research": {
      "post": {
        "summary": "Research Endpoint",
        "operationId": "research_endpoint_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchSubmit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "get": {
        "summary": "List Runs",
        "operationId": "list_runs_runs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Runs Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}": {
      "get": {
        "summary": "Get Session",
        "operationId": "get_session_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "include_traces",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Traces"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchSession"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/events/json": {
      "get": {
        "summary": "Events Json",
        "description": "事件历史（一次性拉取；SSE 用于实时流）。",
        "operationId": "events_json_runs__run_id__events_json_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TraceEvent"
                  },
                  "title": "Response Events Json Runs  Run Id  Events Json Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "summary": "Stream Events",
        "operationId": "stream_events_runs__run_id__events_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel Run",
        "operationId": "cancel_run_runs__run_id__cancel_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Cancel Run Runs  Run Id  Cancel Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "summary": "List Documents",
        "operationId": "list_documents_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentMeta"
                  },
                  "type": "array",
                  "title": "Response List Documents Documents Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload",
        "operationId": "upload_documents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/index/build": {
      "post": {
        "summary": "Build",
        "operationId": "build_index_build_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/BuildRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexVersion"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/index/versions": {
      "get": {
        "summary": "Versions",
        "operationId": "versions_index_versions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IndexVersion"
                  },
                  "type": "array",
                  "title": "Response Versions Index Versions Get"
                }
              }
            }
          }
        }
      }
    },
    "/index/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_index_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuildRequest": {
        "properties": {
          "dense": {
            "type": "boolean",
            "title": "Dense",
            "default": false
          },
          "entity_graph": {
            "type": "boolean",
            "title": "Entity Graph",
            "default": false
          }
        },
        "type": "object",
        "title": "BuildRequest"
      },
      "BuildStage": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "pending"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "BuildStage"
      },
      "DocumentIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "format": {
            "type": "string",
            "title": "Format",
            "default": "txt"
          }
        },
        "type": "object",
        "required": [
          "name",
          "content"
        ],
        "title": "DocumentIn"
      },
      "DocumentMeta": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "name",
          "format",
          "fingerprint",
          "size",
          "created_at"
        ],
        "title": "DocumentMeta"
      },
      "DocumentUploadResult": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/DocumentMeta"
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "meta"
        ],
        "title": "DocumentUploadResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model",
            "default": ""
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          },
          "index": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Index"
          },
          "n_traces": {
            "type": "integer",
            "title": "N Traces",
            "default": 0
          },
          "n_runs": {
            "type": "integer",
            "title": "N Runs",
            "default": 0
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "IndexStatus": {
        "properties": {
          "runtime_version": {
            "type": "string",
            "title": "Runtime Version",
            "default": ""
          },
          "built_version": {
            "type": "string",
            "title": "Built Version",
            "default": ""
          },
          "mismatch": {
            "type": "boolean",
            "title": "Mismatch",
            "default": false
          },
          "n_documents": {
            "type": "integer",
            "title": "N Documents",
            "default": 0
          },
          "n_chunks": {
            "type": "integer",
            "title": "N Chunks",
            "default": 0
          },
          "n_versions": {
            "type": "integer",
            "title": "N Versions",
            "default": 0
          },
          "last_error": {
            "type": "string",
            "title": "Last Error",
            "default": ""
          },
          "available_tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Tools"
          },
          "stage_status": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Stage Status"
          }
        },
        "type": "object",
        "title": "IndexStatus"
      },
      "IndexVersion": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "n_documents": {
            "type": "integer",
            "title": "N Documents",
            "default": 0
          },
          "n_chunks": {
            "type": "integer",
            "title": "N Chunks",
            "default": 0
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/BuildStage"
            },
            "type": "array",
            "title": "Stages"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "version",
          "created_at"
        ],
        "title": "IndexVersion"
      },
      "ResearchEvidence": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "default": ""
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "default": ""
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "default": ""
          },
          "score": {
            "type": "number",
            "title": "Score",
            "default": 0.0
          },
          "retriever": {
            "type": "string",
            "title": "Retriever",
            "default": ""
          },
          "rank": {
            "type": "integer",
            "title": "Rank",
            "default": 0
          }
        },
        "type": "object",
        "title": "ResearchEvidence",
        "description": "对外证据项：Atlas 只需要\"哪篇文章的哪段原文支持了答案\"，不需要内部块结构。"
      },
      "ResearchRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "default": ""
          },
          "subtask_id": {
            "type": "string",
            "title": "Subtask Id",
            "default": ""
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "budget_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Budget Tokens",
            "default": 0
          },
          "max_rounds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Rounds",
            "default": 2
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key",
            "default": ""
          },
          "timeout_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "Timeout S",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ResearchRequest",
        "description": "Atlas 调用 CompassRAG 的请求（阶段 A 契约，阶段 E 由 API 复用）。"
      },
      "ResearchResult": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer",
            "default": ""
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/ResearchEvidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0.0
          },
          "retrieval_rounds": {
            "type": "integer",
            "title": "Retrieval Rounds",
            "default": 0
          },
          "stop_reason": {
            "type": "string",
            "title": "Stop Reason",
            "default": ""
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "default": ""
          },
          "failure": {
            "type": "string",
            "enum": [
              "",
              "timeout",
              "budget_exhausted",
              "no_evidence",
              "upstream_error",
              "invalid_request",
              "cancelled"
            ],
            "title": "Failure",
            "default": ""
          }
        },
        "type": "object",
        "title": "ResearchResult",
        "description": "对外响应：答案 + 结构化证据 + 置信度 + 停止原因 + trace 指针。"
      },
      "ResearchSession": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array",
            "title": "Runs"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "ResearchSession",
        "description": "一次会话（Atlas 的一个子任务上下文）里的运行集合。"
      },
      "ResearchSubmit": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "default": ""
          },
          "subtask_id": {
            "type": "string",
            "title": "Subtask Id",
            "default": ""
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "budget_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Budget Tokens",
            "default": 0
          },
          "max_rounds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Rounds",
            "default": 2
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key",
            "default": ""
          },
          "timeout_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "Timeout S",
            "default": 0.0
          },
          "async_mode": {
            "type": "boolean",
            "title": "Async Mode",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ResearchSubmit",
        "description": "提交一次研究任务。`async_mode=True` 时立刻返回 run_id，用 SSE 订阅进度。"
      },
      "RunEnvelope": {
        "properties": {
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunSummary"
